@@ -109,9 +110,24 @@ def netlist_from_simple_spec(
     input_port_bitwidths: dict[str, int] | None = None,
     output_port_bitwidths: dict[str, int] | None = None,
 ) -> Netlist:
+    def _resolve_schem(schem_name: str) -> str:
+        # iverilog -tvhdl renames Verilog modules that collide with
+        # VHDL reserved words (xor, and, or, not, ...) by appending
+        # "_module". Our stub library uses the original Verilog name
+        # (e.g. xor.schem, not xor_module.schem), so strip the suffix
+        # when the literal lookup misses.
+        primary = f"schematics/{schem_name}.schem"
+        if os.path.exists(primary):
+            return primary
+        if schem_name.endswith("_module"):
+            fallback = f"schematics/{schem_name[:-len('_module')]}.schem"
+            if os.path.exists(fallback):
+                return fallback
+        return primary  # let load_schem raise its own FileNotFoundError
+
     instances = {
         name: schematic_instance_from_schem(
-            load_schem(f"schematics/{config['schem_name']}.schem")
+            load_schem(_resolve_schem(config["schem_name"]))
         )
         for name, config in instance_config.items()
     }

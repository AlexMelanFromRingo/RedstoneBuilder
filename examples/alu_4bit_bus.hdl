// 4-bit ALU — bus-syntax edition (V3.P2 demo).
//
// Functionally identical to examples/alu_4bit.hdl, but written with
// v3 multi-bit wire/port declarations. A bus `wire [3:0] x;` desugars
// into four scalar nets x[0]..x[3]; `x[2]` selects one bit. This is
// pure syntactic sugar — the netlist sees the same flat scalar nets.
//
// Opcodes (op[1] op[0]): 00 ADD, 01 SUB, 10 AND, 11 OR.
module alu_4bit_bus(
    input [3:0] a,
    input [3:0] b,
    input [1:0] op,
    output [3:0] y,
    output cout
);
    wire nop0, nop1, sub_mode, and_active, or_active;
    wire [3:0] bx;
    wire [3:0] abx;
    wire [3:0] sum;
    wire [3:0] g;
    wire [3:0] p;
    wire [4:1] c;
    wire [3:0] aand;
    wire [3:0] aor;
    wire [3:0] ag;
    wire [3:0] ng;
    wire [3:0] og;
    wire [3:0] m;

    // ── opcode decode ───────────────────────────────────────────────
    not d_n0(.A(op[0]), .Y(nop0));
    not d_n1(.A(op[1]), .Y(nop1));
    and d_sub(.A(nop1), .B(op[0]), .Y(sub_mode));     // op == 01
    and d_and(.A(op[1]), .B(nop0), .Y(and_active));   // op == 10
    and d_or(.A(op[1]), .B(op[0]), .Y(or_active));    // op == 11

    // ── second operand: B XOR sub_mode ──────────────────────────────
    xor bx_0(.A(b[0]), .B(sub_mode), .Y(bx[0]));
    xor bx_1(.A(b[1]), .B(sub_mode), .Y(bx[1]));
    xor bx_2(.A(b[2]), .B(sub_mode), .Y(bx[2]));
    xor bx_3(.A(b[3]), .B(sub_mode), .Y(bx[3]));

    // ── ripple-carry adder, carry-in = sub_mode ─────────────────────
    xor fa0_x1(.A(a[0]), .B(bx[0]), .Y(abx[0]));
    xor fa0_x2(.A(abx[0]), .B(sub_mode), .Y(sum[0]));
    and fa0_a1(.A(a[0]), .B(bx[0]), .Y(g[0]));
    and fa0_a2(.A(abx[0]), .B(sub_mode), .Y(p[0]));
    or  fa0_o1(.A(g[0]), .B(p[0]), .Y(c[1]));

    xor fa1_x1(.A(a[1]), .B(bx[1]), .Y(abx[1]));
    xor fa1_x2(.A(abx[1]), .B(c[1]), .Y(sum[1]));
    and fa1_a1(.A(a[1]), .B(bx[1]), .Y(g[1]));
    and fa1_a2(.A(abx[1]), .B(c[1]), .Y(p[1]));
    or  fa1_o1(.A(g[1]), .B(p[1]), .Y(c[2]));

    xor fa2_x1(.A(a[2]), .B(bx[2]), .Y(abx[2]));
    xor fa2_x2(.A(abx[2]), .B(c[2]), .Y(sum[2]));
    and fa2_a1(.A(a[2]), .B(bx[2]), .Y(g[2]));
    and fa2_a2(.A(abx[2]), .B(c[2]), .Y(p[2]));
    or  fa2_o1(.A(g[2]), .B(p[2]), .Y(c[3]));

    xor fa3_x1(.A(a[3]), .B(bx[3]), .Y(abx[3]));
    xor fa3_x2(.A(abx[3]), .B(c[3]), .Y(sum[3]));
    and fa3_a1(.A(a[3]), .B(bx[3]), .Y(g[3]));
    and fa3_a2(.A(abx[3]), .B(c[3]), .Y(p[3]));
    or  fa3_o1(.A(g[3]), .B(p[3]), .Y(c[4]));

    // ── bitwise logic lanes ─────────────────────────────────────────
    and l_and0(.A(a[0]), .B(b[0]), .Y(aand[0]));
    and l_and1(.A(a[1]), .B(b[1]), .Y(aand[1]));
    and l_and2(.A(a[2]), .B(b[2]), .Y(aand[2]));
    and l_and3(.A(a[3]), .B(b[3]), .Y(aand[3]));
    or  l_or0(.A(a[0]), .B(b[0]), .Y(aor[0]));
    or  l_or1(.A(a[1]), .B(b[1]), .Y(aor[1]));
    or  l_or2(.A(a[2]), .B(b[2]), .Y(aor[2]));
    or  l_or3(.A(a[3]), .B(b[3]), .Y(aor[3]));

    // ── one-hot output MUX (arith / and / or) ───────────────────────
    and mx_ag0(.A(nop1), .B(sum[0]), .Y(ag[0]));
    and mx_ng0(.A(and_active), .B(aand[0]), .Y(ng[0]));
    and mx_og0(.A(or_active), .B(aor[0]), .Y(og[0]));
    or  mx_m0(.A(ag[0]), .B(ng[0]), .Y(m[0]));
    or  mx_y0(.A(m[0]), .B(og[0]), .Y(y[0]));

    and mx_ag1(.A(nop1), .B(sum[1]), .Y(ag[1]));
    and mx_ng1(.A(and_active), .B(aand[1]), .Y(ng[1]));
    and mx_og1(.A(or_active), .B(aor[1]), .Y(og[1]));
    or  mx_m1(.A(ag[1]), .B(ng[1]), .Y(m[1]));
    or  mx_y1(.A(m[1]), .B(og[1]), .Y(y[1]));

    and mx_ag2(.A(nop1), .B(sum[2]), .Y(ag[2]));
    and mx_ng2(.A(and_active), .B(aand[2]), .Y(ng[2]));
    and mx_og2(.A(or_active), .B(aor[2]), .Y(og[2]));
    or  mx_m2(.A(ag[2]), .B(ng[2]), .Y(m[2]));
    or  mx_y2(.A(m[2]), .B(og[2]), .Y(y[2]));

    and mx_ag3(.A(nop1), .B(sum[3]), .Y(ag[3]));
    and mx_ng3(.A(and_active), .B(aand[3]), .Y(ng[3]));
    and mx_og3(.A(or_active), .B(aor[3]), .Y(og[3]));
    or  mx_m3(.A(ag[3]), .B(ng[3]), .Y(m[3]));
    or  mx_y3(.A(m[3]), .B(og[3]), .Y(y[3]));

    // ── carry-out, valid for ADD/SUB only ───────────────────────────
    and o_cout(.A(c[4]), .B(nop1), .Y(cout));
endmodule

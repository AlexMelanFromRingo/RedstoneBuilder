// 4-bit ripple-carry adder, built hierarchically from a 1-bit
// full_adder sub-module (V3.P5 — hierarchical HDL).
//
// Compare with examples/ripple_adder_8bit.hdl, which inlines every
// full adder by hand: here the full adder is written once and
// instantiated four times. Elaboration flattens the hierarchy before
// synthesis, so the result is an ordinary 20-gate combinational
// netlist — `adder4` never appears as a "module" downstream.
//
// Compile with the v2 router:
//   redstonebuilder examples/adder4_hier.hdl -o add4.litematic \
//       --router pathfinder
module full_adder(input a, input b, input cin, output sum, output cout);
    wire ab, ab_cin, ab_and;
    xor x1(.A(a), .B(b), .Y(ab));
    xor x2(.A(ab), .B(cin), .Y(sum));
    and a1(.A(a), .B(b), .Y(ab_and));
    and a2(.A(ab), .B(cin), .Y(ab_cin));
    or  o1(.A(ab_and), .B(ab_cin), .Y(cout));
endmodule

module adder4(
    input [3:0] a,
    input [3:0] b,
    input cin,
    output [3:0] s,
    output cout
);
    wire [3:1] c;
    full_adder fa0(.a(a[0]), .b(b[0]), .cin(cin),  .sum(s[0]), .cout(c[1]));
    full_adder fa1(.a(a[1]), .b(b[1]), .cin(c[1]), .sum(s[1]), .cout(c[2]));
    full_adder fa2(.a(a[2]), .b(b[2]), .cin(c[2]), .sum(s[2]), .cout(c[3]));
    full_adder fa3(.a(a[3]), .b(b[3]), .cin(c[3]), .sum(s[3]), .cout(cout));
endmodule

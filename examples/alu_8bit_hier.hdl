// 8-bit ALU, built hierarchically from a reusable 1-bit ALU slice.
//
// This is the payoff of V3.P5 (hierarchical HDL): the 1-bit ALU bit
// is written once as `alu_slice` and instantiated eight times. The
// elaborator flattens it into a flat ~230-gate netlist; the v2
// PathFinder router compiles it end-to-end.
//
// Opcodes (op[1] op[0]): 00 ADD, 01 SUB, 10 AND, 11 OR.
// `cout` is the arithmetic carry-out (meaningful for ADD/SUB).
//
// Compile:
//   redstonebuilder examples/alu_8bit_hier.hdl -o alu8.litematic \
//       --router pathfinder --max-footprint 512x48x512

// ── 1-bit ALU slice ────────────────────────────────────────────────
// Inputs : a, b, cin (carry-in), op0/op1 (opcode).
// Outputs: y (result bit), cout (carry-out).
module alu_slice(
    input a, input b, input cin, input op0, input op1,
    output y, output cout
);
    wire nop0, nop1, sub_mode, and_active, or_active;
    wire bx, abx, sum, g, p, aand, aor, ag, ng, og, m;

    // opcode decode (nop1 doubles as the arithmetic-active enable)
    not n0(.A(op0), .Y(nop0));
    not n1(.A(op1), .Y(nop1));
    and d_sub(.A(nop1), .B(op0), .Y(sub_mode));
    and d_and(.A(op1), .B(nop0), .Y(and_active));
    and d_or(.A(op1), .B(op0), .Y(or_active));

    // adder: second operand is B XOR sub_mode
    xor bxg(.A(b), .B(sub_mode), .Y(bx));
    xor ax1(.A(a), .B(bx), .Y(abx));
    xor ax2(.A(abx), .B(cin), .Y(sum));
    and ag1(.A(a), .B(bx), .Y(g));
    and ag2(.A(abx), .B(cin), .Y(p));
    or  aco(.A(g), .B(p), .Y(cout));

    // bitwise logic lanes
    and l_and(.A(a), .B(b), .Y(aand));
    or  l_or(.A(a), .B(b), .Y(aor));

    // one-hot output mux
    and m_ag(.A(nop1), .B(sum), .Y(ag));
    and m_ng(.A(and_active), .B(aand), .Y(ng));
    and m_og(.A(or_active), .B(aor), .Y(og));
    or  m_m(.A(ag), .B(ng), .Y(m));
    or  m_y(.A(m), .B(og), .Y(y));
endmodule

// ── 8-bit ALU ──────────────────────────────────────────────────────
module alu_8bit(
    input [7:0] a,
    input [7:0] b,
    input [1:0] op,
    output [7:0] y,
    output cout
);
    wire [8:1] c;
    wire top_nop1, top_sub;

    // carry-in for bit 0 is sub_mode: SUB = A + ~B + 1.
    not t_n1(.A(op[1]), .Y(top_nop1));
    and t_sub(.A(top_nop1), .B(op[0]), .Y(top_sub));

    alu_slice s0(.a(a[0]), .b(b[0]), .cin(top_sub), .op0(op[0]), .op1(op[1]), .y(y[0]), .cout(c[1]));
    alu_slice s1(.a(a[1]), .b(b[1]), .cin(c[1]), .op0(op[0]), .op1(op[1]), .y(y[1]), .cout(c[2]));
    alu_slice s2(.a(a[2]), .b(b[2]), .cin(c[2]), .op0(op[0]), .op1(op[1]), .y(y[2]), .cout(c[3]));
    alu_slice s3(.a(a[3]), .b(b[3]), .cin(c[3]), .op0(op[0]), .op1(op[1]), .y(y[3]), .cout(c[4]));
    alu_slice s4(.a(a[4]), .b(b[4]), .cin(c[4]), .op0(op[0]), .op1(op[1]), .y(y[4]), .cout(c[5]));
    alu_slice s5(.a(a[5]), .b(b[5]), .cin(c[5]), .op0(op[0]), .op1(op[1]), .y(y[5]), .cout(c[6]));
    alu_slice s6(.a(a[6]), .b(b[6]), .cin(c[6]), .op0(op[0]), .op1(op[1]), .y(y[6]), .cout(c[7]));
    alu_slice s7(.a(a[7]), .b(b[7]), .cin(c[7]), .op0(op[0]), .op1(op[1]), .y(y[7]), .cout(cout));
endmodule

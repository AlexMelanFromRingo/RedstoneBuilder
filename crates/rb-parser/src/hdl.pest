// HDL grammar — Verilog subset.
// v1: combinational primitives (and/or/not/xor).
// v2: sequential primitives (dtrigger/memcell) inside `always @(posedge clk)` blocks.
// v2 additions: analog wire, comparator(.MODE), observer, repeater (logic
//               primitive with .DELAY/.LOCK), target_block.
// See specs/{001,002}/contracts/hdl-grammar.md for the contracts.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

file = { SOI ~ module_decl ~ EOI }

module_decl = {
    kw_module ~ ident ~ "(" ~ port_list ~ ")" ~ ";"
    ~ module_item*
    ~ kw_endmodule
}

port_list = { port_decl ~ ("," ~ port_decl)* }
port_decl = { port_dir ~ wire_kind? ~ bus_spec? ~ ident }
port_dir  = { kw_input | kw_output }

module_item = _{ wire_decl | gate_inst | comparator_inst | observer_inst | always_block }

// v3: `wire X;` (scalar) or `wire [3:0] X;` (4-bit bus). A bus
// desugars in the parser into one scalar net per bit, named `X[i]`.
wire_decl = { wire_kind ~ bus_spec? ~ ident ~ ("," ~ ident)* ~ ";" }
wire_kind = { kw_analog ~ kw_wire | kw_wire }

// Bus width declaration: `[msb:lsb]`. Either endianness is accepted;
// bit count is |msb - lsb| + 1.
bus_spec = { "[" ~ integer_lit ~ ":" ~ integer_lit ~ "]" }

// v1 combinational + v2 logic primitives (repeater, target_block).
gate_inst = { gate_kind ~ ident ~ "(" ~ conn_list ~ ")" ~ ";" }
gate_kind = { kw_and | kw_or | kw_not | kw_xor | kw_repeater | kw_target_block }
conn_list = { conn ~ ("," ~ conn)* }
conn      = { "." ~ ident ~ "(" ~ conn_arg ~ ")" }

// A connection target is either an integer literal (used by repeater
// .DELAY(N)) or a net reference — a bare ident or a bit-indexed bus
// element `bus[i]`.
conn_arg     = { integer_lit | net_ref }
net_ref      = { ident ~ bit_index? }
bit_index    = { "[" ~ integer_lit ~ "]" }
integer_lit  = @{ ASCII_DIGIT+ }

// v2: comparator carries an explicit .MODE(compare|subtract).
comparator_inst = {
    kw_comparator ~ ident ~ "(" ~ conn_list ~ "," ~ mode_attr ~ ")" ~ ";"
}
mode_attr = { "." ~ kw_mode_id ~ "(" ~ (kw_compare | kw_subtract) ~ ")" }
kw_mode_id = @{ "MODE" ~ !ident_continue }

// v2: observer has exactly two named ports — .WATCH and .OUT.
observer_inst = {
    kw_observer ~ ident ~ "(" ~ conn ~ "," ~ conn ~ ")" ~ ";"
}

// v1 sequential primitives inside `always` blocks.
always_block = {
    kw_always ~ "@" ~ "(" ~ edge_spec ~ ")"
    ~ kw_begin ~ stateful_inst+ ~ kw_end
}
edge_spec       = { (kw_posedge | kw_negedge) ~ ident }
stateful_inst   = { stateful_kind ~ ident ~ "(" ~ conn_list ~ ")" ~ ";" }
stateful_kind   = { kw_dtrigger | kw_memcell }

kw_module      = @{ "module"       ~ !ident_continue }
kw_endmodule   = @{ "endmodule"    ~ !ident_continue }
kw_input       = @{ "input"        ~ !ident_continue }
kw_output      = @{ "output"       ~ !ident_continue }
kw_wire        = @{ "wire"         ~ !ident_continue }
kw_analog      = @{ "analog"       ~ !ident_continue }
kw_and         = @{ "and"          ~ !ident_continue }
kw_or          = @{ "or"           ~ !ident_continue }
kw_not         = @{ "not"          ~ !ident_continue }
kw_xor         = @{ "xor"          ~ !ident_continue }
kw_always      = @{ "always"       ~ !ident_continue }
kw_posedge     = @{ "posedge"      ~ !ident_continue }
kw_negedge     = @{ "negedge"      ~ !ident_continue }
kw_begin       = @{ "begin"        ~ !ident_continue }
kw_end         = @{ "end"          ~ !ident_continue }
kw_dtrigger    = @{ "dtrigger"     ~ !ident_continue }
kw_memcell     = @{ "memcell"      ~ !ident_continue }
kw_comparator  = @{ "comparator"   ~ !ident_continue }
kw_observer    = @{ "observer"     ~ !ident_continue }
kw_repeater    = @{ "repeater"     ~ !ident_continue }
kw_target_block = @{ "target_block" ~ !ident_continue }
kw_compare     = @{ "compare"      ~ !ident_continue }
kw_subtract    = @{ "subtract"     ~ !ident_continue }

ident = @{ !(reserved ~ !ident_continue) ~ ident_start ~ ident_continue* }

ident_start    = _{ ASCII_ALPHA | "_" }
ident_continue = _{ ASCII_ALPHANUMERIC | "_" }
reserved = _{
    "module" | "endmodule" | "input" | "output" | "wire" | "analog"
  | "and" | "or" | "not" | "xor"
  | "always" | "posedge" | "negedge" | "begin" | "end"
  | "dtrigger" | "memcell"
  | "comparator" | "observer" | "repeater" | "target_block"
  | "compare" | "subtract"
  | "parameter" | "localparam" | "generate" | "endgenerate"
  | "assign" | "function" | "task" | "case" | "if" | "else" | "for" | "while"
  | "reg"
}

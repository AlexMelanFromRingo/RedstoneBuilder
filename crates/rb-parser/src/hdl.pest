// HDL grammar — Verilog subset.
// US1: combinational primitives (and/or/not/xor).
// US2: sequential primitives (dtrigger/memcell) inside `always @(posedge clk)` blocks.
// See specs/001-hdl-compiler-cli/contracts/hdl-grammar.md for the contract.

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ "//" ~ (!"\n" ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

file = { SOI ~ module_decl ~ EOI }

module_decl = {
    kw_module ~ ident ~ "(" ~ port_list ~ ")" ~ ";"
    ~ module_item*
    ~ kw_endmodule
}

port_list = { port_decl ~ ("," ~ port_decl)* }
port_decl = { port_dir ~ ident }
port_dir  = { kw_input | kw_output }

module_item = _{ wire_decl | gate_inst | always_block }

wire_decl = { kw_wire ~ ident ~ ("," ~ ident)* ~ ";" }

gate_inst = { gate_kind ~ ident ~ "(" ~ conn_list ~ ")" ~ ";" }
gate_kind = { kw_and | kw_or | kw_not | kw_xor }
conn_list = { conn ~ ("," ~ conn)* }
conn      = { "." ~ ident ~ "(" ~ ident ~ ")" }

always_block = {
    kw_always ~ "@" ~ "(" ~ edge_spec ~ ")"
    ~ kw_begin ~ stateful_inst+ ~ kw_end
}
edge_spec       = { (kw_posedge | kw_negedge) ~ ident }
stateful_inst   = { stateful_kind ~ ident ~ "(" ~ conn_list ~ ")" ~ ";" }
stateful_kind   = { kw_dtrigger | kw_memcell }

kw_module    = @{ "module"    ~ !ident_continue }
kw_endmodule = @{ "endmodule" ~ !ident_continue }
kw_input     = @{ "input"     ~ !ident_continue }
kw_output    = @{ "output"    ~ !ident_continue }
kw_wire      = @{ "wire"      ~ !ident_continue }
kw_and       = @{ "and"       ~ !ident_continue }
kw_or        = @{ "or"        ~ !ident_continue }
kw_not       = @{ "not"       ~ !ident_continue }
kw_xor       = @{ "xor"       ~ !ident_continue }
kw_always    = @{ "always"    ~ !ident_continue }
kw_posedge   = @{ "posedge"   ~ !ident_continue }
kw_negedge   = @{ "negedge"   ~ !ident_continue }
kw_begin     = @{ "begin"     ~ !ident_continue }
kw_end       = @{ "end"       ~ !ident_continue }
kw_dtrigger  = @{ "dtrigger"  ~ !ident_continue }
kw_memcell   = @{ "memcell"   ~ !ident_continue }

ident = @{ !(reserved ~ !ident_continue) ~ ident_start ~ ident_continue* }

ident_start    = _{ ASCII_ALPHA | "_" }
ident_continue = _{ ASCII_ALPHANUMERIC | "_" }
reserved = _{
    "module" | "endmodule" | "input" | "output" | "wire"
  | "and" | "or" | "not" | "xor"
  | "always" | "posedge" | "negedge" | "begin" | "end"
  | "dtrigger" | "memcell"
  | "parameter" | "localparam" | "generate" | "endgenerate"
  | "assign" | "function" | "task" | "case" | "if" | "else" | "for" | "while"
  | "reg"
}
